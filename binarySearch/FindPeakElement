https://leetcode.com/problems/find-peak-element/description/

class Solution {
    public int findPeakElement(int[] nums) {
        int n = nums.length;
        int l = 0, r = n - 1, mid;

        if (n == 1)
            return 0;

        while (l <= r) {
            mid = l + (r - l)/2;

            if (mid > 0 && mid < n - 1) {
                if (nums[mid] > nums[mid-1] && nums[mid] > nums[mid+1])
                    return mid;
                else if (nums[mid] > nums[mid-1])
                    l = mid + 1;
                else
                    r = mid - 1;        
            }
            else {
                // corner elements
                if (mid == 0) {
                    if (nums[mid] > nums[mid+1])
                        return mid;
                    else    
                        return 1;    
                }
                else if (mid == n-1) {
                    if (nums[mid] > nums[mid-1])
                        return mid;
                    else    
                        return mid-1;
                }
            }
        }

        return -1;
    }
}
